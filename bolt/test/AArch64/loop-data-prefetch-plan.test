# RUN: not %python %p/../../utils/loop-data-prefetch-plan.py --hints %t/test/wrong-opcode --binary %t.exe --bolt %llvm_bolt --output-dir %t/failed-static 2>&1 | FileCheck %s --check-prefix=STATIC-ERROR
