# RUN: llvm-nm %t.exe > %t/symbols
# RUN: %python %t/test/prepare.py %t/symbols %t/test
# RUN: %python %p/../../utils/loop-data-prefetch-plan.py --hints %t/test/first %t/test/second %t/test/first --output-dir %t/merged
